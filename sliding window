2)Longest Substring With Exactly K Distinct Characters
function longestSubstring(str, k) {
    let map = new Map();
    let left = 0;
    let maxLen = 0;

    for (let right = 0; right < str.length; right++) {

        // Add current character
        map.set(str[right], (map.get(str[right]) || 0) + 1);

        // Too many distinct characters → shrink
        while (map.size > k) {
            map.set(str[left], map.get(str[left]) - 1);

            if (map.get(str[left]) === 0) {
                map.delete(str[left]);
            }

            left++;
        }

        // Exactly k distinct characters
        if (map.size === k) {
            maxLen = Math.max(maxLen, right - left + 1);
        }
    }

    return maxLen;
}
