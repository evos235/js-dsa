7)Remove Consecutive Duplicates
Given:

let str = "aaabbccdaa";

Return:

"abcda"
let res = "";

for (let i = 0; i < str.length; i++) {
    if (str[i] == str[i - 1]) {
        continue;
    }

    res = res + str[i];
}

return res;

8)reverse every word;
Given:

let str = "I love JavaScript";

Expected:

"I evol tpircSavaJ"

let res = "";
let rev = [];
let arr = str.split(" ");

for (let word of arr) {
    let ch = word.split("");

    let i = 0, j = ch.length - 1;

    while (i < j) {
        [ch[i], ch[j]] = [ch[j], ch[i]];
        i++, j--;
    }

    let w = ch.join("");
    rev.push(w);
}

res = rev.join(" ");

9)Reverse the Order of Words
input:
let str = "I love JavaScript";
Output:
"JavaScript love I"

 let words = str.split(" ");
let result = [];

for (let i = words.length - 1; i >= 0; i--) {
    result.push(words[i]);
}

return result.join(" ");

10)Most Frequent Character
let str = "programming";

Find the character that occurs the most.

Expected:

"r" or "g"?

Actually, carefully count it before answering:

